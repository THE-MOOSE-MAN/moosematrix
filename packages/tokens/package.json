{
  "name": "@moosematrix/tokens",
  "version": "0.1.2",
  "description": "Moose Matrix design tokens, Tailwind v4 theme, self-hosted fonts, logos, and the shared header, footer and search overlay as plain HTML/CSS/JS.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./header.css": "./header.css",
    "./footer.css": "./footer.css",
    "./search.css": "./search.css",
    "./nav.js": "./nav.js",
    "./theme-core.js": "./theme-core.js",
    "./theme-init.js": "./theme-init.js",
    "./hashed/*": "./hashed/*",
    "./nav.json": "./nav.json",
    "./nav.schema.json": "./nav.schema.json",
    "./render.mjs": "./render.mjs",
    "./search.js": "./search.js",
    "./header.html": "./header.html",
    "./footer.html": "./footer.html",
    "./search.html": "./search.html",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "theme.css",
    "fonts.css",
    "header.css",
    "footer.css",
    "search.css",
    "nav.js",
    "theme-core.js",
    "theme-init.js",
    "hashed/",
    "nav.json",
    "nav.schema.json",
    "render.mjs",
    "search.js",
    "header.html",
    "footer.html",
    "search.html",
    "fonts/",
    "brand/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-demo.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"scripts/*.test.mjs\""
  }
}
