{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moosematrix.com/schemas/tokens/nav.schema.json",
  "title": "@moosematrix/tokens nav.json",
  "description": "Single source for the shared header and footer navigation. render.mjs validates nav.json against these same rules (no dependencies) and HTML-escapes every value before rendering; tests/render.test.mjs checks the two agree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "main",
    "research",
    "siteRows",
    "heroTopics",
    "menuExtras"
  ],
  "properties": {
    "$schema": {
      "const": "./nav.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "main": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/mainLink"
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "siteRows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mooseman": {
          "$ref": "#/$defs/row"
        },
        "m2": {
          "$ref": "#/$defs/row"
        },
        "merch": {
          "$ref": "#/$defs/row"
        }
      }
    },
    "heroTopics": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "q"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[A-Za-z0-9 $-]+$"
          },
          "scope": {
            "enum": [
              "library",
              "mumbles",
              "reading-room",
              "ctf",
              "money"
            ]
          }
        }
      }
    },
    "menuExtras": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "href": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https://(moosematrix\\.com|mooseman\\.moosematrix\\.com|m2\\.moosematrix\\.com|merch\\.moosematrix\\.com)(/[A-Za-z0-9._~/-]*)?$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "href"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "href": {
          "$ref": "#/$defs/href"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "items"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "mainLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "href",
        "tick"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "href": {
          "$ref": "#/$defs/href"
        },
        "tick": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    }
  }
}
