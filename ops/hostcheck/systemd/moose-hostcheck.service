# moose-hostcheck: daily read-only host check. Installed by ops/hostcheck/install.sh.
# Runs as the dedicated non-root user moose-hostcheck. It needs the docker group to read the docker socket,
# which is root-equivalent (docker can start a privileged container); see ops/hostcheck/README.md.
# The sandbox below limits what a bug in the script itself can do outside that socket.
[Unit]
Description=Moose host check (read-only, writes /var/lib/moose-hostcheck)
Documentation=https://github.com/THE-MOOSE-MAN/moosematrix/tree/main/ops/hostcheck
After=docker.service

[Service]
Type=oneshot
User=moose-hostcheck
Group=moose-hostcheck
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 -I /usr/local/lib/moose-hostcheck/moose_hostcheck.py
StateDirectory=moose-hostcheck
StateDirectoryMode=0755
UMask=0022
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/moose-hostcheck
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
